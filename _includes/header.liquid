{% if page.permalink != '/' %}
  <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
    {% if site.title == 'blank' %}
      <span class="font-weight-bold">
        {% if site.first_name %}
          {{- site.first_name -}}
        {% endif %}
        {% if site.middle_name %}
          {{- site.middle_name -}}
        {% endif %}
        {% if site.last_name %}
          {{- site.last_name -}}
        {% endif %}
      </span>
    {% else %}
      {{- site.title -}}
    {% endif %}
  </a>
{% elsif site.enable_navbar_social %}
  <!-- Social Icons -->
  <div class="navbar-brand social">{% social_links %}</div>
{% endif %}
